# TeamDesk MCP Server - SSE Remote Configuration
# Copy this file to .env and fill in your credentials

# Master admin token - used to validate API keys in the API-Keys table
TEAMDESK_MASTER_TOKEN=your_master_token_here

# Your TeamDesk database ID
TEAMDESK_DATABASE_ID=your_database_id

# Name of the API Keys table in TeamDesk (default: API-Keys)
# Required columns: Key, Token, Ativo, Nome, Ultimo_Uso
TEAMDESK_API_KEYS_TABLE=API-Keys

# Server
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Security
MCP_RATE_LIMIT=100
MCP_MAX_PAYLOAD_SIZE=1048576
MCP_CORS_ORIGINS=

# Performance
MCP_CACHE_TTL=300
MCP_API_KEY_CACHE_TTL=60
