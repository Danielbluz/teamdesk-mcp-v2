# TeamDesk MCP Server - Configuration
# Copy this file to .env and fill in your credentials

# Your TeamDesk REST API token (required)
# Generate at: TeamDesk > Setup > Integration > REST API > Tokens
TEAMDESK_TOKEN=your_token_here

# Your TeamDesk database ID (required)
# Found in TeamDesk URL: teamdesk.net/secure/db/XXXXX
TEAMDESK_DATABASE_ID=your_database_id
